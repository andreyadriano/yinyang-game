{
  "name": "yinyang-game",
  "version": "1.0.0",
  "private": true,
  "description": "Yin Yang: jogo 2D de ação e plataforma em Phaser 3",
  "type": "module",
  "scripts": {
    "start": "serve . -l 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test && npm run test:worker",
    "prepare": "husky",
    "relay": "node server/relay.js",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8788",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "test:worker": "playwright test -c playwright.worker.config.js",
    "test:online-worker": "RELAY=ws://localhost:8788 playwright test tests/online.spec.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "serve": "^14.2.0",
    "wrangler": "^4.158.0",
    "ws": "^8.22.2"
  }
}
