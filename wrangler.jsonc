{
  // One Worker that serves the whole game: the website (the files in dist/, built by `npm run build:site`)
  // and the relay for online co-op (/room/ABC234). Deploy with: npm run deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yinyang",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-04-07",

  // The website. A request that matches a file in dist/ is answered with that file without running the
  // Worker (static files are free and unlimited); anything else (/room/..., /health) reaches the Worker.
  "assets": {
    "directory": "./dist"
  },

  // Your own address, instead of yinyang.<subdomain>.workers.dev. The domain must be active on
  // Cloudflare (see worker/DEPLOY.md). Remove the comment markers and put your hostname; on the next
  // deploy Cloudflare creates the DNS record and the certificate by itself.
  // "routes": [{ "pattern": "jogo.seudominio.com", "custom_domain": true }],

  "vars": {
    // Pages allowed to open a room, comma separated: "self" is the page served by this same Worker
    // (the default), "*" is any page, or full addresses like "https://outro.exemplo.com".
    "ALLOWED_ORIGINS": "self",

    // The off switch: "false" refuses every new connection (redeploy to flip it). Use it if someone
    // is hammering the server and you want to protect the daily free limits.
    "ONLINE_ENABLED": "true",

    // Connection attempts allowed per address: a burst of CONNECT_BURST, then CONNECT_PER_MINUTE a minute.
    "CONNECT_BURST": "20",
    "CONNECT_PER_MINUTE": "20",

    // How long a host may wait alone for a friend, and the most a room may live (milliseconds).
    "ROOM_WAITING_MS": "600000",
    "ROOM_MAX_MS": "10800000"
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },

  // The free plan only supports Durable Objects with SQLite storage (this one stores nothing).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]

  // Optional extra layer: Cloudflare's own rate limiter. The Worker uses it automatically when this
  // binding exists. Its availability on the free plan is not stated in the docs, so it is off by
  // default; see worker/README.md. To try it, remove the comment markers:
  // "ratelimits": [
  //   { "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  // ]
}
